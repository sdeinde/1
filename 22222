package kisi;

public class Kisi {
    String ad, soyad;
    int yas;

    public Kisi(String ad, String soyad, int yas) {
        super();
        this.ad = ad;
        this.soyad = soyad;
        this.yas = yas;
    }

    @Override
    public String toString() {
        return "\nad : " + ad + "\nsoyad : " + soyad + "\nyas : " + yas;
    }

    public int dtHesapla() {
        return 2026 - this.yas;
    }

    public void bilgiGoster() {
        System.out.println("Adı : " + ad + " Soyadı : " + soyad);
    }
}



çpackage kisi;

public class Ogrenci extends Kisi {
    String numara, bolum;

    public Ogrenci(String ad, String soyad, int yas, String numara, String bolum) {
        super(ad, soyad, yas);
        this.numara = numara;
        this.bolum = bolum;
    }

    @Override
    public String toString() {
        super.toString();
        return "\nnumara : " + numara + "\nbolum : " + bolum;
    }

    public void bilgiGoster() {
        super.bilgiGoster();
        System.out.println("Bölümü : " + bolum);
    }
}
